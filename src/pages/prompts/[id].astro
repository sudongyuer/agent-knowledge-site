---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getSortedSkills, githubRepo, promptSummary } from '../../lib/content';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts');
  return prompts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, category, tags, author, source_url, additional_sources, variants, date, status } = entry.data;
const { Content } = await render(entry);
const repos = new Set([source_url, ...(additional_sources ?? [])].map(githubRepo).filter(Boolean));
const relatedSkills = (await getSortedSkills()).filter((s) => repos.has(githubRepo(s.data.source_url)));
---

<Base title={title} description={promptSummary(entry)}>
  <nav class="breadcrumb" aria-label="面包屑">
    <a href="/prompts/">Prompt 库</a>
    <a href={`/prompts/?category=${encodeURIComponent(category)}`}>{category}</a>
  </nav>
  <article data-pagefind-body>
    <header>
      <div class="meta-row">
        <span class="badge" data-pagefind-filter="category">{category}</span>
        <time datetime={date}>收录于 {date}</time>
        {status && <span class="chip">{status}</span>}
      </div>
      <h1 class="detail-title">{title}</h1>
    </header>

    <dl class="facts">
      {
        author && (
          <div class="facts__row">
            <dt>
              作者
            </dt>
            <dd>{author}</dd>
          </div>
        )
      }
      {
        source_url && (
          <div class="facts__row">
            <dt>
              原文
            </dt>
            <dd>
              <a href={source_url}>{source_url}</a>
            </dd>
          </div>
        )
      }
      {
        additional_sources && additional_sources.length > 0 && (
          <div class="facts__row">
            <dt>
              其他来源
            </dt>
            <dd>
              <ul>
                {additional_sources.map((url) => (
                  <li>
                    <a href={url}>{url}</a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
      {
        tags.length > 0 && (
          <div class="facts__row">
            <dt>
              标签
            </dt>
            <dd class="facts__tags">
              {tags.map((tag) => (
                <a class="chip" href={`/prompts/?tag=${encodeURIComponent(tag)}`}>
                  #{tag}
                </a>
              ))}
            </dd>
          </div>
        )
      }
      {
        relatedSkills.length > 0 && (
          <div class="facts__row">
            <dt>同源 Skill</dt>
            <dd>
              <ul>
                {relatedSkills.map((s) => (
                  <li>
                    <a href={`/skills/${s.id}/`}>{s.data.title}</a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
      {
        variants && variants.length > 0 && (
          <div class="facts__row">
            <dt>
              变体
            </dt>
            <dd>
              <ul>
                {variants.map((v) => (
                  <li>{v}</li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
