---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在">
  <header class="page-header">
    <h1>页面不存在 <span class="count">404</span></h1>
    <p>这个地址没有内容，可能已经改名或删除。</p>
  </header>
  <p class="actions">
    <a class="pill-btn pill-btn--dark" href="/">回到首页</a>
    <a class="pill-btn" href="/search/">搜索</a>
  </p>
</Base>

<style>
  .actions {
    display: flex;
    gap: 0.5rem;
  }
</style>
