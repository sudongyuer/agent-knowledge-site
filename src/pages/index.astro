---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import LibraryCard from '../components/LibraryCard.astro';
import LibraryToolbar from '../components/LibraryToolbar.astro';
import { getSortedBriefs, getSortedPrompts } from '../lib/content';
import { briefItems, countBy, promptItems } from '../lib/library';

const briefs = await getSortedBriefs();
const prompts = await getSortedPrompts();
const prompt = await promptItems();
const brief = await briefItems();
const categories = countBy(prompts.map((p) => p.data.category));
const tags = countBy(prompts.flatMap((p) => p.data.tags));
const { headings } = await render((await getEntry('factory', 'blueprint'))!);
const chapters = headings.filter((h) => h.depth === 2 && /^\d+\./.test(h.text));
const concepts = briefs.filter(({ meta }) => meta.conceptName).slice(0, 5);
const latestBrief = briefs.find(({ meta }) => meta.concept)?.meta;

const index = [
  {
    heading: 'Prompt 分类',
    all: '/prompts/',
    links: categories.slice(0, 5).map(([name]) => ({ label: name, href: `/prompts/?category=${encodeURIComponent(name)}` })),
  },
  {
    heading: '标签',
    all: '/prompts/',
    links: tags.slice(0, 5).map(([name]) => ({ label: name, href: `/prompts/?tag=${encodeURIComponent(name)}` })),
  },
  {
    heading: '今日概念',
    all: '/briefs/concepts/',
    links: concepts.map(({ meta }) => ({ label: meta.conceptName!.replace(/（.*$/, ''), href: `/briefs/${meta.id}/` })),
  },
  {
    heading: '蓝图章节',
    all: '/blueprint/',
    links: chapters.slice(0, 5).map((h) => ({
      label: h.text.replace(/^\d+\.\s*/, '').replace(/[：:].*$/, ''),
      href: `/blueprint/#${h.slug}`,
    })),
  },
];
---

<Base title="Agent 知识站" layout="wide">
  <section class="hero">
    <h1>Agent 知识站</h1>
    <p>
      三个 bot 收集的 agent 工程资料：每日简报、Prompt 库、软件工厂蓝图。<br />{briefs.length} 期简报，{prompts.length} 条 Prompt，持续更新。
    </p>
    <div class="hero__actions">
      <a class="pill-btn pill-btn--dark" href="/prompts/">浏览 Prompt</a>
      {latestBrief && <a class="pill-btn" href={`/briefs/${latestBrief.id}/`}>今日简报 →</a>}
    </div>
  </section>

  <nav class="index" aria-label="分类索引">
    {
      index.map((col) => (
        <div>
          <h2>{col.heading}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
          <a class="text-link index__all" href={col.all}>
            全部 →
          </a>
        </div>
      ))
    }
  </nav>

  <LibraryToolbar categories={categories} withKindSwitch />

  <ul class="lib-grid" data-grid>
    {prompt.map((item) => <LibraryCard item={item} />)}
    {brief.map((item) => <LibraryCard item={item} hidden />)}
  </ul>
</Base>

<style>
  .hero {
    padding: clamp(3rem, 8vw, 6.5rem) 0 clamp(2.5rem, 6vw, 4.5rem);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 1.8rem + 4.6vw, 5.25rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .hero p {
    margin: 1.25rem auto 0;
    max-width: 40rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .index {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    padding: 2rem 0 2.5rem;
  }

  .index h2 {
    margin: 0 0 0.6rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .index ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index li a {
    display: block;
    padding: 0.1rem 0;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--dur-fast) ease;
  }

  .index__all {
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .index li a:hover {
      color: var(--text-muted);
    }
  }

  @media (max-width: 820px) {
    .index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1.25rem;
    }
  }
</style>
