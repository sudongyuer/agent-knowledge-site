---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import LibraryCard from '../components/LibraryCard.astro';
import LibraryToolbar from '../components/LibraryToolbar.astro';
import { getSortedBriefs, getSortedPrompts } from '../lib/content';
import { briefItems, countBy, promptItems, skillItems } from '../lib/library';

const briefs = await getSortedBriefs();
const prompts = await getSortedPrompts();
const prompt = await promptItems();
const brief = await briefItems();
const skill = await skillItems();
const skillCategories = countBy(skill.map((s) => s.category!));
const categories = countBy(prompts.map((p) => p.data.category));
const tags = countBy(prompts.flatMap((p) => p.data.tags));
const { headings } = await render((await getEntry('factory', 'blueprint'))!);
const chapters = headings.filter((h) => h.depth === 2 && /^\d+\./.test(h.text));
const concepts = briefs.filter(({ meta }) => meta.conceptName).slice(0, 5);
const latestBrief = briefs[0]?.meta;

const index = [
  {
    heading: 'Prompt 分类',
    all: '/prompts/',
    links: categories.slice(0, 5).map(([name]) => ({ label: name, href: `/prompts/?category=${encodeURIComponent(name)}` })),
  },
  {
    heading: '标签',
    all: '/prompts/',
    links: tags.slice(0, 5).map(([name]) => ({ label: name, href: `/prompts/?tag=${encodeURIComponent(name)}` })),
  },
  {
    heading: 'Skill 分类',
    all: '/skills/',
    links: skillCategories.slice(0, 5).map(([name]) => ({ label: name, href: `/skills/?category=${encodeURIComponent(name)}` })),
  },
  {
    heading: '今日概念',
    all: '/briefs/concepts/',
    links: concepts.map(({ meta }) => ({ label: meta.conceptName!.replace(/（.*$/, ''), href: `/briefs/${meta.id}/` })),
  },
  {
    heading: '蓝图章节',
    all: '/blueprint/',
    links: chapters.slice(0, 5).map((h) => ({
      label: h.text.replace(/^\d+\.\s*/, '').replace(/[：:].*$/, ''),
      href: `/blueprint/#${h.slug}`,
    })),
  },
];
---

<Base title="Agent 知识站" layout="wide">
  <section class="hero">
    <h1>Agent 知识站</h1>
    <p>bot 每天收集的 agent 工程资料：{briefs.length} 期简报、{prompts.length} 条 Prompt、{skill.length} 个 Skill，还有一份软件工厂蓝图。</p>
    {
      latestBrief && (
        <a class="pill-btn" href={`/briefs/${latestBrief.id}/`}>
          最新简报 · {latestBrief.date} →
        </a>
      )
    }
  </section>

  <h2 class="visually-hidden">资料库</h2>
  <LibraryToolbar categories={categories} kinds={['Prompt', '简报', 'Skill']} />

  <ul class="lib-grid" data-grid>
    {prompt.map((item) => <LibraryCard item={item} />)}
    {brief.map((item) => <LibraryCard item={item} hidden />)}
    {skill.map((item) => <LibraryCard item={item} hidden />)}
  </ul>

  <nav class="index" aria-labelledby="index-heading">
    <h2 id="index-heading" class="section-title">按主题浏览</h2>
    {
      index.map((col) => (
        <div>
          <h3>{col.heading}</h3>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href} title={l.label}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
          <a class="text-link index__all" href={col.all}>
            全部 →
          </a>
        </div>
      ))
    }
  </nav>
</Base>

<style>
  .hero {
    padding: clamp(1.5rem, 4vw, 3rem) 0 clamp(1.75rem, 4vw, 2.75rem);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.75rem + 2.2vw, 3.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .hero p {
    margin: 0.75rem auto 1.25rem;
    max-width: 40rem;
    color: var(--text-muted);
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.05rem);
    text-wrap: balance;
  }

  .index {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .section-title {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .index h3 {
    margin: 0 0 0.6rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .index ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index li a {
    display: block;
    padding: 0.1rem 0;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--dur-fast) ease;
  }

  .index__all {
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .index li a:hover {
      text-decoration-line: underline;
      text-decoration-color: var(--border-strong);
    }
  }

  @media (max-width: 820px) {
    .index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1.25rem;
    }
  }
</style>
