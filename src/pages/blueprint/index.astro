---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SubNav from '../../components/SubNav.astro';
import Icon from '../../components/Icon.astro';
import { sourceLabel } from '../../lib/content';
import { blueprintNav } from '../../lib/nav';

const entry = (await getEntry('factory', 'blueprint'))!;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { title = 'Agent 软件工厂蓝图', date, source, tags } = entry.data;
---

<Base title={title} layout="wide">
  <SubNav items={blueprintNav} />
  <div class="blueprint">
    <aside class="toc-wrap" aria-label="目录">
      <details class="toc">
        <summary>
          <span class="toc__heading">目录</span>
          <span class="toc__count">{toc.length} 节</span>
        </summary>
        <ol>
          {
            toc.map((h) => (
              <li class={`toc__d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))
          }
        </ol>
      </details>
    </aside>
    <div class="blueprint__main">
      <div class="meta-row blueprint__meta">
        {
          date && (
            <time class="chip" datetime={date}>
              {date}
            </time>
          )
        }
        {tags?.map((t) => <span class="chip">#{t}</span>)}
      </div>
      <article class="prose" data-pagefind-body>
        <Content />
      </article>
      {
        source && (
          <p class="blueprint__source">
            <Icon name="link" size={14} />
            <span>
              原始页面：
              <a href={source} title={source}>
                {sourceLabel(source)}
              </a>
            </span>
          </p>
        )
      }
    </div>
  </div>
</Base>

<style>
  .blueprint {
    display: grid;
    grid-template-columns: 17rem minmax(0, var(--reading-width));
    justify-content: center;
    gap: 3rem;
    align-items: start;
  }

  .blueprint__meta {
    margin-bottom: 1.25rem;
  }

  .blueprint__source {
    display: flex;
    gap: 0.4rem;
    margin: 3rem 0 0;
    padding: 1rem 1.15rem;
    border-radius: var(--radius);
    background: var(--canvas);
    color: var(--text-muted);
    font-size: 0.82rem;
    word-break: break-all;
  }

  .blueprint__source :global(.icon) {
    margin-top: 0.25rem;
  }

  .toc-wrap {
    position: sticky;
    top: var(--header-offset);
  }

  .toc {
    max-height: calc(100vh - var(--header-offset) - 1.5rem);
    overflow-y: auto;
    padding: 1rem 0.6rem 1rem 0.75rem;
    background: var(--canvas);
    border-radius: var(--radius-card);
    font-size: 0.85rem;
    line-height: 1.5;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .toc summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    cursor: pointer;
  }

  .toc summary::-webkit-details-marker {
    display: none;
  }

  .toc__heading {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .toc__count {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .toc ol {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .toc li + li {
    margin-top: 0.1rem;
  }

  .toc a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  .toc__d3 a {
    padding-left: 1.4rem;
    font-size: 0.82rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .toc a:hover {
      color: var(--text);
      background: var(--surface-2);
    }
  }

  .toc a.is-active {
    color: var(--bg);
    background: var(--text);
    font-weight: 600;
  }

  .blueprint :global(.prose > p:has(> strong:only-child):has(+ ul > li:first-child > a[href^='#'])),
  .blueprint :global(.prose > p:has(> strong:only-child) + ul:has(> li:first-child > a[href^='#'])) {
    display: none;
  }

  @media (max-width: 1080px) {
    .blueprint {
      grid-template-columns: minmax(0, var(--reading-width));
      gap: 1.25rem;
    }

    .toc-wrap {
      top: calc(var(--header-offset) - 1rem);
      z-index: 5;
    }

    .blueprint :global(.prose) :global(:is(h1, h2, h3, h4, a)) {
      scroll-margin-top: 3.75rem;
    }

    .toc {
      position: relative;
      max-height: none;
      overflow: visible;
      padding: 0.6rem 1rem;
      background: var(--canvas);
    }

    .toc ol {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      max-height: min(65vh, 32rem);
      overflow-y: auto;
      margin: 0;
      padding: 0.5rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.3);
      overscroll-behavior: contain;
    }
  }
</style>

<script>
  const toc = document.querySelector<HTMLDetailsElement>('.toc');
  const wide = window.matchMedia('(min-width: 1081px)');
  // Closed by default so narrow screens keep the anchor scroll position; the sidebar column doesn't shift the article
  if (toc && wide.matches) toc.open = true;

  const links = new Map<string, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.toc a')) {
    links.set(decodeURIComponent(a.hash.slice(1)), a);
    a.addEventListener('click', () => {
      if (toc && !wide.matches) toc.open = false;
    });
  }

  function activate(id: string) {
    const link = links.get(id);
    if (!link) return;
    const top = wide.matches && toc ? link.offsetTop - toc.clientHeight / 2 : null;
    for (const a of links.values()) {
      a.classList.toggle('is-active', a === link);
      if (a === link) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
    if (top !== null) toc!.scrollTo({ top, behavior: 'auto' });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) if (entry.isIntersecting) activate(entry.target.id);
    },
    { rootMargin: '-12% 0px -78% 0px' },
  );
  for (const id of links.keys()) {
    const heading = document.getElementById(id);
    if (heading) observer.observe(heading);
  }
</script>
