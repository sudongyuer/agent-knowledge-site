---
import Icon from './Icon.astro';

interface Props {
  categories: [string, number][];
  withKindSwitch?: boolean;
}

const { categories, withKindSwitch = false } = Astro.props;
const sorts = [
  { key: 'latest', label: '最新' },
  { key: 'category', label: '按分类' },
  { key: 'variants', label: '有变体' },
];
---

<div class="toolbar" data-toolbar data-categories={JSON.stringify(categories.map(([name]) => name))}>
  {
    withKindSwitch && (
      <div class="seg" role="group" aria-label="内容类型">
        <button type="button" data-kind-btn="Prompt" aria-pressed="true">Prompt</button>
        <button type="button" data-kind-btn="简报" aria-pressed="false">简报</button>
      </div>
    )
  }
  <div class="sorts" data-prompt-only role="group" aria-label="排序">
    {
      sorts.map((s, i) => (
        <button type="button" data-sort={s.key} aria-pressed={i === 0 ? 'true' : 'false'}>
          {s.label}
        </button>
      ))
    }
  </div>
  <div class="toolbar__end" data-prompt-only>
    <button type="button" class="pill-btn pill-btn--dark" data-clear-tag hidden>
      <span class="clear-tag__text" data-clear-tag-text></span>
      <span aria-hidden="true">×</span>
    </button>
    <button type="button" class="pill-btn" data-filter-toggle aria-expanded="false">
      <Icon name="filter" size={14} />
      筛选
    </button>
  </div>
</div>
<div class="chips" data-chips hidden>
  <button type="button" class="pill-btn" data-category="" aria-pressed="true">全部</button>
  {
    categories.map(([name, count]) => (
      <button type="button" class="pill-btn" data-category={name} aria-pressed="false">
        {name}
        <span class="chips__count">{count}</span>
      </button>
    ))
  }
</div>
<p class="empty" data-empty hidden></p>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .seg {
    display: flex;
    padding: 3px;
    border-radius: var(--radius-pill);
    background: var(--pill);
  }

  .seg button {
    height: 1.9rem;
    padding: 0 0.9rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--text-muted);
    font-size: 0.85rem;
    cursor: pointer;
  }

  .seg button[aria-pressed='true'] {
    background: var(--bg);
    color: var(--text);
    font-weight: 600;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }

  .sorts {
    display: flex;
    gap: 1.1rem;
  }

  .sorts button {
    padding: 0.3rem 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--text-muted);
    font-size: 0.9rem;
    cursor: pointer;
    transition: color var(--dur-fast) ease;
  }

  .sorts button[aria-pressed='true'] {
    border-bottom-color: var(--text);
    color: var(--text);
    font-weight: 600;
  }

  .toolbar__end {
    display: flex;
    gap: 0.5rem;
    min-width: 0;
    margin-left: auto;
  }

  [data-clear-tag] {
    min-width: 0;
    max-width: 16rem;
  }

  .clear-tag__text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  [data-filter-toggle] {
    flex-shrink: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .chips[hidden],
  [data-prompt-only][hidden],
  [data-clear-tag][hidden] {
    display: none;
  }

  .chips__count {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .chips [aria-pressed='true'] .chips__count {
    color: inherit;
    opacity: 0.6;
  }

  .empty {
    padding: 4rem 0;
    color: var(--text-muted);
    text-align: center;
  }

  @media (hover: hover) and (pointer: fine) {
    .sorts button:hover,
    .seg button:hover {
      color: var(--text);
    }
  }

  @media (max-width: 820px) {
    .toolbar {
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }

    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * max(1rem, env(safe-area-inset-left)));
      padding-inline: max(1rem, env(safe-area-inset-left));
      scrollbar-width: none;
    }
  }
</style>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-toolbar]')!;
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const chips = document.querySelector<HTMLElement>('[data-chips]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const filterToggle = toolbar.querySelector<HTMLButtonElement>('[data-filter-toggle]')!;
  const clearTag = toolbar.querySelector<HTMLButtonElement>('[data-clear-tag]')!;
  const clearTagText = clearTag.querySelector<HTMLElement>('[data-clear-tag-text]')!;
  const order: string[] = JSON.parse(toolbar.dataset.categories ?? '[]');
  const cards = [...grid.querySelectorAll<HTMLLIElement>('.lib-card')];
  const params = new URLSearchParams(location.search);
  const state = {
    kind: 'Prompt',
    sort: 'latest',
    category: params.get('category') ?? '',
    tag: params.get('tag') ?? '',
  };

  function press(selector: string, attr: string, value: string) {
    for (const el of document.querySelectorAll<HTMLButtonElement>(selector)) {
      el.setAttribute('aria-pressed', String(el.getAttribute(attr) === value));
    }
  }

  function matches(card: HTMLLIElement) {
    if (card.dataset.kind !== state.kind) return false;
    if (state.kind !== 'Prompt') return true;
    const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
    return (
      (!state.category || card.dataset.category === state.category) &&
      (!state.tag || tags.includes(state.tag)) &&
      (state.sort !== 'variants' || card.dataset.variants === 'true')
    );
  }

  function apply() {
    const isPrompt = state.kind === 'Prompt';
    let visible = 0;
    let total = 0;
    for (const card of cards) {
      card.hidden = !matches(card);
      if (!card.hidden) visible++;
      if (card.dataset.kind === state.kind) total++;
    }
    const sorted =
      isPrompt && state.sort === 'category'
        ? [...cards].sort((a, b) => order.indexOf(a.dataset.category!) - order.indexOf(b.dataset.category!))
        : cards;
    grid.append(...sorted);
    const filterable = isPrompt && total > 0;
    for (const el of document.querySelectorAll<HTMLElement>('[data-prompt-only]')) el.hidden = !filterable;
    if (!filterable) chips.hidden = true;
    empty.hidden = visible > 0;
    empty.textContent = total ? '没有符合条件的 Prompt。' : `还没有${isPrompt ? ' Prompt' : state.kind}。`;
    clearTag.hidden = !state.tag;
    clearTagText.textContent = `#${state.tag}`;
    clearTag.title = `清除标签 #${state.tag}`;
    clearTag.setAttribute('aria-label', `清除标签 #${state.tag}`);
    press('[data-kind-btn]', 'data-kind-btn', state.kind);
    press('[data-sort]', 'data-sort', state.sort);
    press('[data-category]', 'data-category', state.category);
    filterToggle.setAttribute('aria-expanded', String(!chips.hidden));
    const query = new URLSearchParams();
    if (state.category) query.set('category', state.category);
    if (state.tag) query.set('tag', state.tag);
    history.replaceState(null, '', query.size ? `?${query}` : location.pathname);
  }

  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!target) return;
    if (target.dataset.kindBtn) state.kind = target.dataset.kindBtn;
    else if (target.dataset.sort) state.sort = target.dataset.sort;
    else if (target.dataset.category !== undefined) state.category = target.dataset.category;
    else if (target.hasAttribute('data-clear-tag')) state.tag = '';
    else if (target.hasAttribute('data-filter-toggle')) chips.hidden = !chips.hidden;
    else return;
    apply();
  });

  if (state.category) chips.hidden = false;
  apply();
</script>
