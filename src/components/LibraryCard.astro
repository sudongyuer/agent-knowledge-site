---
import { collapseBlankLines, type LibraryItem } from '../lib/library';

interface Props {
  item: LibraryItem;
  hidden?: boolean;
}

const { item, hidden = false } = Astro.props;
const excerpt = collapseBlankLines(item.excerpt);
---

<li
  class="lib-card"
  data-kind={item.kind}
  data-category={item.category}
  data-tags={item.tags && JSON.stringify(item.tags)}
  data-variants={item.hasVariants ? 'true' : undefined}
  hidden={hidden}
>
  <a href={item.href}>
    <span class="preview" aria-hidden="true">
      <span class="sheet">
        <span class="sheet__label">{item.label}</span>
        <span class="sheet__title">{item.title}</span>
        {excerpt && <span class="sheet__body">{excerpt}</span>}
      </span>
    </span>
    <span class="lib-card__title" title={item.title}>{item.title}</span>
    <span class="lib-card__meta">
      <span class="lib-card__label" title={item.label}>{item.label}</span>
      {item.meta && <span title={item.meta}>{item.meta}</span>}
    </span>
  </a>
</li>

<style>
  a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: inherit;
    text-decoration: none;
  }

  .preview {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--canvas);
    transition: background-color var(--dur-fast) ease;
  }

  .sheet {
    position: absolute;
    inset: 14% 14% -8%;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.05rem;
    border-radius: 10px 10px 0 0;
    background: var(--paper);
    box-shadow:
      0 0 0 1px var(--paper-edge),
      0 10px 30px -14px rgb(0 0 0 / 0.25);
  }

  .sheet__label {
    color: var(--text-muted);
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  .sheet__title {
    font-size: 11.5px;
    font-weight: 650;
    line-height: 1.4;
  }

  .sheet__body {
    padding-top: 0.45rem;
    border-top: 1px solid var(--border);
    color: var(--text-2);
    font-size: 9.5px;
    line-height: 1.65;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .lib-card__title {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lib-card__meta {
    display: flex;
    gap: 0.5rem;
    min-width: 0;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .lib-card__meta span {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .lib-card__label {
    flex-shrink: 0;
    max-width: 60%;
  }

  .lib-card__meta span + span::before {
    content: '·';
    margin-right: 0.5rem;
  }

  .lib-card[hidden] {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover .preview {
      background-color: var(--canvas-hover);
    }
  }
</style>
