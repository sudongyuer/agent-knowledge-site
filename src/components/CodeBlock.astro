---
import { copyIconHtml, languageLabel } from '../lib/code-block.mjs';

interface Props {
  code: string;
  language?: string;
}

const { code, language } = Astro.props;
---

<div class="code-block">
  <div class="code-block__bar">
    <span class="code-block__lang">{languageLabel(language)}</span>
    <button type="button" class="copy-button"><Fragment set:html={copyIconHtml} /><span>复制</span></button>
  </div>
  <pre data-language={language} translate="no"><code>{code}</code></pre>
</div>
