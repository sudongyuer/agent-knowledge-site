---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/prose.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  layout?: 'wide' | 'reading';
}

const { title, description = 'Agent 工程实践简报、Prompt 库与软件工厂蓝图', layout = 'reading' } = Astro.props;
const siteName = 'Agent 知识站';
const path = Astro.url.pathname;
const nav = [
  { href: '/briefs/', label: '简报' },
  { href: '/prompts/', label: 'Prompt' },
  { href: '/blueprint/', label: '蓝图' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
          const color = theme === 'dark' ? '#0a0a0a' : '#ffffff';
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.content = color;
        }
      } catch {}
    </script>
    <meta name="description" content={description} />
    <title>{title === siteName ? siteName : `${title} · ${siteName}`}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="site-header__bar">
        <div class="site-header__left">
          <a class="site-brand" href="/">
            <span class="site-brand__mark" aria-hidden="true">A</span>
            <span class="site-brand__name">知识站</span>
          </a>
          <nav class="site-nav" aria-label="主导航">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
        <form class="site-search" action="/search/" method="get" role="search">
          <Icon name="search" size={16} />
          <label class="visually-hidden" for="site-q">搜索全站</label>
          <input id="site-q" name="q" type="search" placeholder="搜索简报、Prompt、蓝图…" autocomplete="off" />
        </form>
        <button class="theme-toggle" type="button" aria-label="切换深浅色" title="切换深浅色">
          <Icon name="sun" size={18} class="theme-toggle__sun" />
          <Icon name="moon" size={18} class="theme-toggle__moon" />
        </button>
      </div>
    </header>
    <main id="main" class:list={['site-main', { 'site-main--reading': layout === 'reading' }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span class="site-footer__brand"><span class="site-brand__mark" aria-hidden="true">A</span>{siteName}</span>
        <span>内容来自三个 bot 收集的 Markdown 资料，本站只做渲染，不改动原文。</span>
        <nav aria-label="页脚导航">
          <a href="/briefs/">简报</a>
          <a href="/prompts/">Prompt</a>
          <a href="/blueprint/">蓝图</a>
          <a href="/search/">搜索</a>
        </nav>
      </div>
    </footer>
    <script>
      import '../lib/copy-code.ts';
      import '../lib/theme-toggle.ts';
    </script>
  </body>
</html>
